# Copy to .env if you'd rather configure keys here than in the Settings UI.
# Both are optional — Roblox and the Fortnite Epic sign-in need neither.

# Unlocks Apex Legends + Call of Duty. Free: https://tracker.gg/developers
TRACKER_API_KEY=

# Only for Fortnite *username* lookups. Free: https://dash.fortnite-api.com/
FORTNITE_API_KEY=

# Roblox DevEx payout rate, USD per Robux. Update if Roblox changes it.
DEVEX_RATE_USD=0.0035

PORT=3000
